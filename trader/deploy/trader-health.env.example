# /etc/trader-health.env  (izin 0600, sahibi root:root; DD-9 O13: trader kullanicisi okuyamaz, systemd root olarak okur). Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger.
# Esittir cevresinde bosluk yok; degerde '#' ve tirnak yok. Sir degerleri depoya girmez.
HEARTBEAT_URL=
HEARTBEAT_FAIL_URL=
# Motor var_dir (config/engine.base.json var_dir; icinde <bot>/status.json, ledger.sqlite, state.sqlite)
ENGINE_VAR_DIR=
BACKUP_DIR=/var/backups/trader
BACKUP_KEEP_DAYS=14
# auto: Telegram anahtarlari (/etc/trader-telegram.env) doluysa telegram, degilse log (anahtarsiz CRIT yalniz journal'a duser)
NOTIFIER=auto
# Beklenen motorlar (virgullu). DD-12: ikiz kaldirildi, yalniz learner.
HEALTH_BOTS=learner
HEALTH_MAINTENANCE_FILE=
# Piyasa verisi alarmlari (docs/saglik-spec.md Bolum 15). MARKET_DB bos ise kapali.
MARKET_DB=
# Cift listesi: ENGINE_CONFIG_DIR/engine.base.json `pairs` ya da virgullu MARKET_PAIRS (yoksa feed-status.json listesi).
ENGINE_CONFIG_DIR=
MARKET_PAIRS=
# Varsayilan: $ENGINE_VAR_DIR/feed-status.json
MARKET_FEED_STATUS=
# Testnet golge motoru var dizini (install.sh testnet anahtarlari doluysa var-testnet'e doldurur). Bos = golge motoru izlenmez.
HEALTH_SHADOW_VAR_DIR=
# Alarm esikleri (bos = varsayilan): stopsuz pozisyon (sn, 0 = hemen), borsaya ulasilamama CRIT suresi (sn)
NAKED_ALARM_S=
EXCHANGE_UNREACH_S=
# Canli bot (DD-9 §6): `install.sh --live` doldurur, elle YAZMAYIN. LIVE_BOTS=learner iken saglik canli botu LIVE_VAR_DIR/learner altindan,
# duraklatmayi LIVE_PAUSE_FILE'dan izler (ENGINE_VAR_DIR/PAUSE_FILE kagit ikiz icin kalir). Bos = canli bot yok.
LIVE_BOTS=
LIVE_VAR_DIR=
LIVE_PAUSE_FILE=
