# /etc/trader-testnet.env  (izin 0600, sahibi root:root). SADECE Binance Futures TESTNET anahtari (testnet.binancefuture.com).
# Canli (gercek) anahtar ASLA buraya yazilmaz; canli anahtar ayri dosyada tutulur. Sir degerleri depoya girmez.
# Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger. Esittir cevresinde bosluk yok; tirnak yok.
# Iki anahtar DOLU ve TESTNET_ACIK=1 olana kadar trader-engine-testnet.service ACILMAZ (install.sh). Testnet sahip karariyla KAPALI:
# acmadan once config/engine.testnet.json 14 enstrumana esitlenmeli (kagit evreni), sonra TESTNET_ACIK=1.
BINANCE_API_KEY=
BINANCE_API_SECRET=
TESTNET_ACIK=
# Opsiyonel carpisma korumasi: baska hesap/bot anahtarlarinin SHA256 ozetleri (deger degil): TRADER_DIGER_ANAHTAR_SHA256=etiket:hex64,etiket2:hex64
# Ozet: printf %s "$ANAHTAR" | sha256sum   (ayni anahtar testnet/canli/baska botta kullanilirsa motor acilmaz: key_collision)
