[Unit]
Description=Trader sunucu otomatik guncelleme zamanlayicisi (5 dakikada bir; yeni yesil commit varsa hemen kurar)

[Timer]
# 24.11 kullanici karari: sabit kurulum saati yok; testleri gecen commit en gec ~5 dk icinde kurulur.
# Basarisiz denenen commit tekrar denenmez; kurulum 15 dk mum kapanisina denk gelirse betik birkac dakika bekler.
OnBootSec=3min
OnCalendar=*:0/5
AccuracySec=30s
RandomizedDelaySec=0
Persistent=false

[Install]
WantedBy=timers.target
