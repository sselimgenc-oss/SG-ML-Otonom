# /etc/trader-telegram.env  (izin 0600, sahibi root:root; systemd root olarak okur ve birimlere iletir). Satir: bos, '#' ile
# baslayan tam satir yorum ya da AD=deger. Esittir cevresinde bosluk yok; degerde '#' ve tirnak yok. Sir depoya girmez.
# Yeni bot, yeni token (CT'nin token'i paylasilmaz). Tek chat kimligi, yalniz ozel sohbet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VAR_DIR=/opt/trader/var/telegram
KILL_FILE=/opt/trader/shared/KILL
ENGINE_STATUS_PATH=/opt/trader/var/learner/status.json
HEALTH_STATE_PATH=/var/lib/trader-health/state.json
# Defter yolu (gunluk rapor / kurulum karnesi salt okunur):
LEDGER_PATH=/opt/trader/var/learner/ledger.sqlite
# /durdur (giris duraklatma, 11 §9): motorun cfg.pause_file + ".<bot>" yoluyla AYNI dosya; denetim: ENGINE_VAR_DIR/<bot>/pause_audit.jsonl
PAUSE_FILE=/opt/trader/shared/PAUSE
ENGINE_VAR_DIR=/opt/trader/var
PAUSE_BOTS=learner
# Risk kademe denetimi (12 §9; /kademe ve /kademe_devam): kademe izlenecek bot(lar). BOS = komutlar kapali ("kademe denetimi
# yapilandirilmadi"). Canliya gecista canli botun adi yazilir (11 §13 gecis listesi); gunluk ENGINE_VAR_DIR/<bot>/risk_ladder.jsonl.
LADDER_BOTS=
# Canli bot (DD-9 §6.4): `install.sh --live` doldurur, elle YAZMAYIN (KILL_FILE, ENGINE_STATUS_PATH, LEDGER_PATH da canli yola cevrilir).
# LIVE_BOTS=learner iken /hepsini_kapat ve /devam yalniz canli botun KILL dosyasini etkiler; /durdur her iki bota kendi dosyasindan uygulanir.
# Yollar config/engine.live.json ile tutarli degilse daemon acilmaz. Bos = canli bot yok.
LIVE_BOTS=
LIVE_VAR_DIR=
LIVE_PAUSE_FILE=
# (`--live` ayrica ENGINE_CONFIG_DIR=<kok>/config ekler; bos birakilmaz: saglik birimi bu dosyayi da yukler ve bos deger oradakini ezerdi.)
