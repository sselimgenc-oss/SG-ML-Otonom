[Unit]
Description=Trader gece egitimi: M1 (DD-12 WP-18)
Documentation=file:///opt/trader/docs/motor/dd12-capraz-varlik-spec.md
# 24.11: zamanlayici 00:40 UTC'ye tasindi. 25.11: ders ve not isleri kaldirildi (ogrenme ML1'de); sira bagimliligi kalmadi.
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=oneshot
User=trader
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/ml_retrain_run.py --once
TimeoutStartSec=900
# WP-18 olcumu (scripts/ml_retrain_run.py, 10 cift, M1@1h/M1@4h): tepe RSS ~263 MB. MemoryHigh 250M
# (yumusak; birkac sn yavaslama) korunur, MemoryMax 300M -> 350M (sert tavan; OOM oldurmesi kalmasin). Yumusak tavan toplami (D-T14) degismez.
MemoryHigh=250M
MemoryMax=350M
CPUQuota=50%
Nice=10
ProtectSystem=strict
ProtectHome=read-only
# yazma yalniz calisma zamani dizinine: var/learner/models/pa_proposer, var/learner/paper_models.csv (git-izli dosyalar yazilmaz)
ReadWritePaths=/opt/trader/var/learner
NoNewPrivileges=true
PrivateTmp=true
