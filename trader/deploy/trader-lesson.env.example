# /etc/trader-lesson.env  (izin 0600, sahibi root:root). Satir: bos, '#' ile baslayan tam satir yorum ya da AD=deger.
# Esittir cevresinde bosluk yok; degerde '#' ve tirnak yok. Sir degerleri depoya girmez.
ANTHROPIC_API_KEY_LESSON=
# `install.sh --live` LEDGER_PATH'i canli deftere (var-live/learner/ledger.sqlite) cevirir (DD-9 Not-2: ders canli islemlerden ogrenir; mentor ayrica gozden gecirir).
LEDGER_PATH=/opt/trader/var/learner/ledger.sqlite
LESSON_STORE_PATH=/opt/trader/user_data/lesson.sqlite
ANTHROPIC_API_KEY_HAFTALIK_OZET=
# Ust lig: YZ yorumcu (gunluk rapor; butce payi yorumcu). Bos birakilirsa rapor yerine 'bugun rapor yok: API anahtari yok' yazilir.
ANTHROPIC_API_KEY_YORUMCU=
# Haber sinyali (haber_kolu butce payi; Haiku 5.5). Bos birakilirsa var/learner/sinyal/haber_sinyal.json yenilenmez.
ANTHROPIC_API_KEY_HABER=
