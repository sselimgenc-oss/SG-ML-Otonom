[Unit]
Description=Trader Telegram komut dinleyici ve outbox bosaltici (tek daemon)
Documentation=file:///opt/trader/docs/telegram-spec.md
After=network-online.target
Wants=network-online.target
OnFailure=trader-health-fail@%n.service

[Service]
Slice=trader.slice
Type=simple
User=trader
WorkingDirectory=/opt/trader
SupplementaryGroups=trader-tg
EnvironmentFile=/etc/trader-telegram.env
ExecStart=/usr/bin/python3 -I /opt/trader/scripts/telegram_run.py daemon
Restart=always
RestartSec=5
MemoryMax=96M
CPUQuota=10%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# user_data DIZIN duzeyinde (lesson.sqlite WAL, budget.sqlite journal, lesson.lock; `lesson_run.py --resolve` alt sureci icin; OPEN-2).
# var/learner: ders aktivasyonu icin yazma; var/learner: /durdur denetim gunlugu (pause_audit.jsonl) icin yazma.
ReadWritePaths=/opt/trader/var/telegram /opt/trader/shared /opt/trader/user_data -/opt/trader/var/learner -/opt/trader/var-live/learner
# Kurulum: groupadd trader-tg; usermod -aG trader-tg trader; install -d -m 2770 -o trader -g trader-tg /opt/trader/var/telegram/outbox

[Install]
# Yeniden baslatmada kendiliginden acilsin (23.11: reboot sonrasi static oldugu icin kapali kalmisti; install.sh enable_now artik gercekten etkinlestirir).
WantedBy=multi-user.target
